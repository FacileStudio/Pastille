{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["tscircuit"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["env.d.ts", "index.tsx", "subcircuits/**/*.tsx", "bodies/**/*.ts", "fab/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
